{
  "name": "@allezrobert/sequences",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./tokens.css": "./tokens.css",
    "./package.json": "./package.json",
    "./render-summary": "./scripts/render-summary.ts"
  },
  "scripts": {
