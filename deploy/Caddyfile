# Caddy : HTTPS automatique (Let's Encrypt) pour le jeu, l'API, les salles et la voix.
# Variables (fichier deploy/.env) : DOMAIN, LIVEKIT_DOMAIN, ACME_EMAIL.
# Derrière Nginx Proxy Manager (docker-compose.npm.yml), Caddy écoute en HTTP sur :80 et NPM
# fait le HTTPS : DOMAIN et LIVEKIT_DOMAIN sont alors réécrits en http://… (docs/DEPLOY_NPM.md).
#
# Plan du site :
#   /                    site de présentation (deploy/site, volume)
#   /telechargement/*    installateurs Windows (deploy/data/downloads, volume)
#   /jouer               jeu web (client) ; ses fichiers restent à la racine (/assets, /worlds…)
#   /companion/          appli compagnon (PWA)
#   /api/*, /colyseus/*  serveur
{
	email {$ACME_EMAIL}
	servers {
		# Derrière un proxy (NPM) : garder l'IP réelle du joueur dans X-Forwarded-For.
		trusted_proxies static private_ranges
	}
}

{$DOMAIN:allezrobert.cparfait.ovh} {
	# Compression : textes, JSON (dont les tuiles du monde) et binaires d'altitude (.u16).
	encode {
		zstd
		gzip 6
		minimum_length 512
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
			header Content-Type application/wasm*
			header Content-Type application/octet-stream*
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Bluetooth (capteurs en Web Bluetooth) et micro (voix LiveKit) pour le site lui-même.
		Permissions-Policy "bluetooth=(self), microphone=(self), camera=(), geolocation=()"
		-Server
	}

	# API HTTP (comptes, profils, sorties, intégrations, rendu).
	handle /api/* {
		reverse_proxy server:2567
	}

	# Salles Colyseus : matchmaking HTTP + WebSocket, préfixe retiré.
	handle_path /colyseus/* {
		reverse_proxy server:2567
	}

	# Tuiles du monde (≈150 Mo, hors du bundle du jeu) : volume deploy/data/worlds monté en
	# lecture seule sur /srv/worlds. world.json et routes/ restent servis depuis le bundle.
	@tiles path /worlds/*/tiles/*
	handle @tiles {
		root * /srv
		header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		# packs de cartes : l'application Windows (autre origine) télécharge les tuiles
		header Access-Control-Allow-Origin "*"
		file_server
	}

	# Tuile absente (mise à jour en cours) : ne jamais garder ce 404 dans le navigateur, sinon il
	# reste 7 jours en cache alors que le fichier existe de nouveau.
	handle_errors {
		@tiles404 path /worlds/*/tiles/*
		header @tiles404 Cache-Control "no-store"
	}

	# Boucles vidéo du menu (≈20 Mo chacune, hors du dépôt et de l'image) : volume deploy/data/menu
	# monté sur /srv/menu (docs/DEPLOY.md §12 bis). Absentes : 404, le menu garde l'image fixe.
	@menuloops path /menu/loop-*
	handle @menuloops {
		root * /srv
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Appli compagnon (PWA).
	redir /companion /companion/ 308
	handle_path /companion/* {
		root * /srv/companion
		@sw path /sw.js /manifest.webmanifest
		header @sw Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	# Site de présentation : la page d'accueil et ses fichiers (/site/…).
	@home path / /index.html
	handle @home {
		root * /srv/site
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}
	handle_path /site/* {
		root * /srv/site
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Installateurs Windows, publiés par deploy/publish-desktop.sh (docs/BUILD_EXE.md).
	# Les noms versionnés ne changent jamais ; allez-robert-setup.exe et version.json suivent
	# la dernière version (pas de cache long), comme latest.json, lu par les applications installées
	# pour se mettre à jour. media/<empreinte>.<ext> : ressources du jeu de l'application, jamais réécrites
	# (l'extension donne le type : JSON compressé par l'encode global, vidéos et modèles servis tels quels).
	redir /telechargement /telechargement/ 308
	handle_path /telechargement/* {
		root * /srv/downloads
		@installer path *.exe *.msi
		header @installer Content-Disposition "attachment"
		@latest path /version.json /latest.json /allez-robert-setup.exe /allez-robert.msi
		header @latest Cache-Control "no-cache"
		@media path /media/*
		header @media Cache-Control "public, max-age=31536000, immutable"
		header /version.json Access-Control-Allow-Origin "*"
		file_server {
			browse
		}
	}

	# Jeu web : /jouer ouvre le jeu ; ses fichiers (/assets, /worlds, /models…) restent servis
	# depuis la racine, d'où le repli final sur le client.
	redir /jouer/ /jouer 308
	handle /jouer {
		root * /srv/client
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	# Fichiers du jeu (client web).
	handle {
		root * /srv/client
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Graphes routiers des zones : l'application Windows (autre origine) ne les embarque pas, elle les
		# télécharge ici avec le pack de la zone.
		@graphs path /worlds/*/graph.json
		header @graphs Access-Control-Allow-Origin "*"
		try_files {path}
		file_server
	}
}

# Signalisation LiveKit (WebSocket) ; les médias passent en direct sur 7881/tcp et 7882/udp.
{$LIVEKIT_DOMAIN:livekit.allezrobert.cparfait.ovh} {
	reverse_proxy livekit:7880
}
