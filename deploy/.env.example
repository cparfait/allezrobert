# Allez Robert ! — configuration du déploiement (copier en deploy/.env sur le VPS, chmod 600).
# AUCUN secret réel dans le dépôt : générer les valeurs sur le VPS (voir docs/DEPLOY.md).

# ───── Domaines ─────
DOMAIN=allezrobert.cparfait.ovh
LIVEKIT_DOMAIN=livekit.allezrobert.cparfait.ovh
ACME_EMAIL=moi@exemple.fr

# ───── Images (GHCR, publiées par la CI) ─────
SERVER_IMAGE=ghcr.io/cparfait/allezrobert-server:latest
WEB_IMAGE=ghcr.io/cparfait/allezrobert-web:latest
RENDERER_IMAGE=ghcr.io/cparfait/allezrobert-renderer:latest
# Épingler une version de LiveKit testée (voir https://github.com/livekit/livekit/releases)
LIVEKIT_IMAGE=livekit/livekit-server:latest
# Services optionnels : « render » démarre le worker vidéo (désactiver sur un petit VPS : COMPOSE_PROFILES=)
COMPOSE_PROFILES=render

# ───── Base de données ─────
POSTGRES_PASSWORD=a-generer-openssl-rand-hex-24

# ───── Secrets du serveur ─────
# openssl rand -base64 48
SESSION_SECRET=a-generer-openssl-rand-base64-48-a-generer-openssl-rand
# openssl rand -base64 32 — À SAUVEGARDER À PART : sans elle, FC, FIT et jetons sont illisibles
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ───── Connexion ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# smtps://utilisateur:motdepasse@ssl0.ovh.net:465 (adresse e-mail OVH, par exemple)
SMTP_URL=
SMTP_FROM=Allez Robert ! <no-reply@cparfait.ovh>

# ───── Voix (LiveKit) ─────
# Clé : lettres/chiffres (ex. APIallezrobert) ; secret : openssl rand -base64 32
LIVEKIT_API_KEY=APIallezrobert
LIVEKIT_API_SECRET=a-generer-openssl-rand-base64-32
# Repli de la voix : lien d'invitation PERMANENT d'un salon vocal Discord (https://discord.gg/…),
# proposé dans le jeu quand LiveKit ne répond pas (docs/DEPLOY.md §9 bis). Vide = pas de repli.
DISCORD_VOICE_INVITE=

# ───── Monde ─────
# Tuiles du monde (≈150 Mo) copiées depuis apps/client/public/worlds/ (voir docs/DEPLOY.md §12)
WORLDS_DIR=./data/worlds
# Itinéraires lus par le serveur (défaut : ceux de l'image, identiques au bundle du jeu)
# ROUTES_DIR=/data/worlds/chevreuse/routes

# ───── Réglages ─────
ALLOW_ANONYMOUS_GUESTS=true
GUEST_MAX_WKG=3.5
RECONNECT_GRACE_S=30
LOG_LEVEL=info

# ───── Sauvegardes ─────
# Heure (UTC) du pg_dump quotidien et durée de rétention
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
# Dossier des sauvegardes sur le VPS (relatif à deploy/)
BACKUP_DIR=./backups
