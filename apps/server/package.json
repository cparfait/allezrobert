    "@colyseus/schema": "^5.0.42",
    "@colyseus/ws-transport": "^0.18.4",
    "@garmin/fitsdk": "^21.218.0",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "msgpackr": "^2.1.2",
    "pg-mem": "^3.0.14"
