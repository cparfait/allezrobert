# Allez Robert ! — configuration du serveur (exemple SANS secret, à copier en .env)
# Générer les secrets :
#   SESSION_SECRET      : openssl rand -base64 48
#   DATA_ENCRYPTION_KEY : openssl rand -base64 32   (à SAUVEGARDER : sans elle, FC et FIT sont illisibles)

NODE_ENV=development
PORT=2567
HOST=0.0.0.0
# URL publique du jeu (redirections après connexion)
PUBLIC_URL=http://localhost:5173
# URL publique de l'API (rappels OAuth, liens magiques) ; en production = PUBLIC_URL
API_PUBLIC_URL=http://localhost:2567
# Origines autorisées (jeu + appli compagnon)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# postgres://allezrobert:motdepasse@localhost:5432/allezrobert, ou « memory » (pg-mem, dev)
DATABASE_URL=memory
DATABASE_SSL=false

SESSION_SECRET=remplacer-par-openssl-rand-base64-48-remplacer-par-openssl
SESSION_TTL_DAYS=30
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
COOKIE_SECURE=auto

# OAuth (laisser vide pour désactiver un fournisseur)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Liens magiques par e-mail : smtp://utilisateur:motdepasse@smtp.exemple.fr:587 (vide = lien affiché dans le journal en dev)
SMTP_URL=
SMTP_FROM=Allez Robert ! <no-reply@allezrobert.cparfait.ovh>

# Voix (LiveKit auto-hébergé)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Repli de la voix : salon Discord (lien d'invitation permanent) proposé si LiveKit est absent ou échoue
DISCORD_VOICE_INVITE=

# Itinéraires (RouteData JSON) ; vide ou absent = boucle procédurale de développement
ROUTES_DIR=../client/public/worlds/chevreuse/routes
RENDERS_DIR=./renders

RECONNECT_GRACE_S=30
ALLOW_ANONYMOUS_GUESTS=true
GUEST_MAX_WKG=3.5
# Connexion de développement sans OAuth (POST /api/auth/dev) — refusée en production
DEV_LOGIN=true
LOG_LEVEL=info

# Voix off du tutoriel (Cartesia) — clé à garder hors du dépôt
CARTESIA_API_KEY=
