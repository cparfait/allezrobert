{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Allez Robert !",
  "version": "0.1.21",
  "identifier": "fr.cparfait.allezrobert",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../client/dist",
    "beforeDevCommand": "pnpm --filter @allezrobert/client dev",
    "beforeBuildCommand": "pnpm --filter @allezrobert/client build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Allez Robert !",
        "width": 1920,
        "height": 1080,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --force_high_performance_gpu --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --gpu-disk-cache-size-kb=262144"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "category": "SportsGame",
    "shortDescription": "Vélo d'intérieur multijoueur entre amis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "fr-FR"
      },
      "nsis": {
        "languages": [
          "French"
        ],
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCNUExOERGOUI4ODg4N0MKUldSOGlJaWIzeGhhRzBNMHE5VFJuR254OWM4VlpnQThmTytHbHdtaTd2aEsvNGFEd2plR0s3a1EK",
      "endpoints": [
        "https://allezrobert.cparfait.ovh/telechargement/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
