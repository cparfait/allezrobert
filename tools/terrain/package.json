{
  "name": "@allezrobert/terrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:world": "tsx src/build-world.ts",
    "build:routes": "tsx src/build-world.ts --routes-only --no-ortho",
    "packs": "tsx src/build-packs.ts",
    "close-loops": "tsx src/close-loops.ts",
    "fetch:osm": "tsx src/fetch-osm.ts",
    "test": "vitest run --root ../.. tools/terrain",
    "places": "tsx src/places.ts",
    "zone-builder": "tsx src/zone-builder.ts",
    "regen:orthos": "tsx src/regen-orthos.ts",
    "style-profile": "tsx src/style-profile.ts"
  },
  "dependencies": {
    "@allezrobert/shared": "workspace:*"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
